\RequirePackage{enumitem}
\setlist[itemize]{%
  topsep=6pt,      % space before first item
  itemsep=6pt,     % space between items
  parsep=0pt,      % space between paragraphs within items
  partopsep=0pt,   % extra space in list environment
}
\let\tightlist\relax

% Sectioning
\setcounter{secnumdepth}{1}

% ========== CHAPTER ==========
\RedeclareSectionCommand[
  level=0,
  font=\normalfont\huge\bfseries,
  tocentryformat=\normalfont\normalsize\bfseries,
  tocentrynumwidth=12pt,
  beforeskip=0.25\textheight,
  afterskip=1.5\baselineskip,
  afterindent=false
]{chapter}

% Number in margin
\renewcommand\chapterformat{\llap{\thechapter\hspace{10pt}}}

% ========== SECTION ==========
\RedeclareSectionCommand[
  level=1,
  font=\normalfont\large\bfseries,
  tocentrynumwidth=18pt,
  tocbeforeskip=2pt,
  beforeskip=\baselineskip,
  afterskip=0.5\baselineskip,
  indent=0pt,
  tocindent=12pt,
  afterindent=false
]{section}

\renewcommand\sectionformat{\llap{\thesection\hspace{10pt}}}

% ========== SUBSECTION ==========
\RedeclareSectionCommand[
  level=2,
  font=\normalfont\normalsize\itshape,
  tocentryformat=\normalfont\normalsize\itshape,
  tocentrynumwidth=0pt,
  tocbeforeskip=2pt,
  beforeskip=\baselineskip,
  afterskip=0.5\baselineskip,
  indent=0pt,
  tocindent=30pt,
  afterindent=false
]{subsection}

\renewcommand\subsectionformat{\llap{\thesubsection\hspace{10pt}}}

\addtokomafont{caption}{\small\rmfamily}
\addtokomafont{captionlabel}{\bfseries\rmfamily}
% \setcapseparator{:\quad}
\setcapindent{0pt}
\KOMAoptions{captions=tableheading}

